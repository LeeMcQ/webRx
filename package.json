{
  "name": "radioreceiver",
  "description": "A website that lets you listen to the radio from your browser using an RTL-SDR tuner.",
  "version": "0.0.1",
  "author": "Jacobo Tarrio <jtarrio@gmail.com>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node ./build.mjs",
    "build-on-change": "onchange \"src\" \"tools\" \"apps\" -- npm run build",
    "serve": "browser-sync start --server \"dist/\" --files \"dist/\" --startPath \"apps/radioreceiver\"",
    "watch": "npm run build && run-p serve build-on-change",
    "dist": "nx build radioreceiver",
    "deploy": "gh-pages -d dist/apps/radioreceiver",
    "build:wasm": "dsp-rs/build.sh",
    "bench:dsp": "node bench/run.mjs dsp_benchmark",
    "test:devices": "node bench/run.mjs devices.test",
    "typecheck": "tsc --noEmit -p .",
    "docs": "node ./build.mjs --dist && rm -rf docs && cp -r dist/apps/radioreceiver docs",
    "test:compass": "node bench/run.mjs compass.test",
    "test:map": "node bench/run.mjs map.test",
    "test:sampling": "node bench/run.mjs sampling.test",
    "test:coverage": "node bench/run.mjs coverage.test"
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "commander": "^12.1.0",
    "esbuild": "^0.28.0",
    "esbuild-plugin-tsc": "^0.4.0",
    "gh-pages": "^6.3.0",
    "glob": "^10.4.5",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@jtarrio/signals": "^0.9.5",
    "@jtarrio/webrtlsdr": "^3.0.3",
    "@types/leaflet": "^1.9.12",
    "@types/w3c-web-usb": "^1.0.10",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lit": "^3.2.1"
  }
}
